{
  "name": "fedora-firewall-control-web",
  "version": "0.1.2",
  "private": true,
  "description": "Local read-only dashboard for Fedora Firewall Control",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-client-assets.mjs",
    "start": "node dist/server/index.js",
    "test": "tsx --test tests/*.test.ts tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.0",
    "ajv": "8.20.0",
    "fastify": "5.10.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
