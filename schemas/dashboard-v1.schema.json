{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ffc.local/schemas/dashboard-v1.schema.json",
  "title": "FFC Dashboard Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "snapshot_id", "hostname", "application_version", "collected_at", "age_ms", "stale", "status", "assessment", "risk", "firewall", "listeners", "network", "evidence", "recommendation"],
  "properties": {
    "schema": {"const": "ffc.dashboard.v1"},
    "schema_version": {"const": 1},
    "snapshot_id": {"type": "integer", "minimum": 1},
    "hostname": {"type": "string"},
    "application_version": {"type": "string"},
    "collected_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "age_ms": {"type": "integer", "minimum": 0},
    "stale": {"type": "boolean"},
    "status": {"$ref": "#/$defs/evidenceStatus"},
    "assessment": {"$ref": "#/$defs/assessment"},
    "risk": {"$ref": "#/$defs/risk"},
    "firewall": {"$ref": "#/$defs/firewall"},
    "listeners": {"$ref": "#/$defs/listeners"},
    "network": {"$ref": "#/$defs/network"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "recommendation": {"$ref": "#/$defs/recommendation"}
  },
  "$defs": {
    "evidenceStatus": {"type": "string", "enum": ["available", "partial", "unavailable"]},
    "nullableString": {"type": ["string", "null"]},
    "nullableBoolean": {"type": ["boolean", "null"]},
    "nullableInteger": {"type": ["integer", "null"], "minimum": 0},
    "assessment": {"type": "object", "additionalProperties": false, "required": ["mode", "defcon_readiness"], "properties": {"mode": {"enum": ["normal", "hostile"]}, "defcon_readiness": {"enum": ["not_evaluated", "ready", "not_ready"]}}},
    "risk": {"type": "object", "additionalProperties": false, "required": ["level", "blockers", "review_items", "coverage_gaps"], "properties": {"level": {"enum": ["ready", "review_required", "blocked"]}, "blockers": {"type": "integer", "minimum": 0}, "review_items": {"type": "integer", "minimum": 0}, "coverage_gaps": {"type": "integer", "minimum": 0}}},
    "firewall": {"type": "object", "additionalProperties": false, "required": ["active_status", "active", "enabled_status", "enabled", "default_zone_status", "default_zone", "policy_status", "inbound_port_rules", "protocol_rules", "rich_rules", "intra_zone_forwarding"], "properties": {"active_status": {"$ref": "#/$defs/evidenceStatus"}, "active": {"$ref": "#/$defs/nullableBoolean"}, "enabled_status": {"$ref": "#/$defs/evidenceStatus"}, "enabled": {"$ref": "#/$defs/nullableBoolean"}, "default_zone_status": {"$ref": "#/$defs/evidenceStatus"}, "default_zone": {"$ref": "#/$defs/nullableString"}, "policy_status": {"$ref": "#/$defs/evidenceStatus"}, "inbound_port_rules": {"$ref": "#/$defs/nullableInteger"}, "protocol_rules": {"$ref": "#/$defs/nullableInteger"}, "rich_rules": {"$ref": "#/$defs/nullableInteger"}, "intra_zone_forwarding": {"$ref": "#/$defs/nullableBoolean"}}},
    "listeners": {"type": "object", "additionalProperties": false, "required": ["status", "tcp_udp_listeners", "reachable_bindings"], "properties": {"status": {"$ref": "#/$defs/evidenceStatus"}, "tcp_udp_listeners": {"$ref": "#/$defs/nullableInteger"}, "reachable_bindings": {"$ref": "#/$defs/nullableInteger"}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["status", "uses_tunnel", "diagnostic"], "properties": {"status": {"$ref": "#/$defs/evidenceStatus"}, "uses_tunnel": {"$ref": "#/$defs/nullableBoolean"}, "diagnostic": {"type": "string"}}},
    "network": {"type": "object", "additionalProperties": false, "required": ["physical_interface", "zone", "network_manager", "tunnel_detection", "vpn_route", "dns_path", "kill_switch"], "properties": {"physical_interface": {"$ref": "#/$defs/nullableString"}, "zone": {"$ref": "#/$defs/nullableString"}, "network_manager": {"type": "object", "additionalProperties": false, "required": ["device_inventory_status", "profile_inventory_status", "profile", "autoconnect", "diagnostic"], "properties": {"device_inventory_status": {"$ref": "#/$defs/evidenceStatus"}, "profile_inventory_status": {"$ref": "#/$defs/evidenceStatus"}, "profile": {"$ref": "#/$defs/nullableString"}, "autoconnect": {"$ref": "#/$defs/nullableBoolean"}, "diagnostic": {"type": "string"}}}, "tunnel_detection": {"type": "object", "additionalProperties": false, "required": ["status", "tunnel_interface"], "properties": {"status": {"$ref": "#/$defs/evidenceStatus"}, "tunnel_interface": {"$ref": "#/$defs/nullableString"}}}, "vpn_route": {"$ref": "#/$defs/verification"}, "dns_path": {"$ref": "#/$defs/verification"}, "kill_switch": {"type": "object", "additionalProperties": false, "required": ["status", "enabled", "diagnostic"], "properties": {"status": {"$ref": "#/$defs/evidenceStatus"}, "enabled": {"$ref": "#/$defs/nullableBoolean"}, "diagnostic": {"type": "string"}}}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["status", "components"], "properties": {"status": {"$ref": "#/$defs/evidenceStatus"}, "components": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["component", "status", "detail"], "properties": {"component": {"type": "string"}, "status": {"$ref": "#/$defs/evidenceStatus"}, "detail": {"type": "string"}}}}}},
    "recommendation": {"type": "object", "additionalProperties": false, "required": ["id", "severity", "category", "summary", "destination"], "properties": {"id": {"type": "string"}, "severity": {"enum": ["critical", "high", "medium", "low", "information"]}, "category": {"enum": ["isolation", "firewall_failure", "firewall_exposure", "listener_exposure", "configuration_change", "evidence_gap", "hygiene"]}, "summary": {"type": "string"}, "destination": {"type": "string", "pattern": "^[a-z]+(\\.[a-z_]+)*$"}}}
  }
}
